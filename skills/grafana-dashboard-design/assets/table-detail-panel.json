{
  "type": "table",
  "title": "Detail table",
  "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
  "datasource": { "type": "prometheus", "uid": "$datasource" },
  "targets": [
    {
      "refId": "A",
      "expr": "topk(20, sum(rate(http_requests_total{service=~\"$service\"}[$__rate_interval])) by (service, route, method, status))",
      "legendFormat": "{{service}} {{method}} {{route}} {{status}}",
      "format": "table",
      "instant": true
    }
  ],
  "transformations": [
    {
      "id": "organize",
      "options": {
        "excludeByName": {},
        "indexByName": {},
        "renameByName": {
          "Value": "Requests/s"
        }
      }
    }
  ],
  "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": { "show": false, "reducer": ["sum"], "countRows": false },
    "sortBy": [{ "desc": true, "displayName": "Requests/s" }]
  },
  "fieldConfig": {
    "defaults": {
      "custom": {
        "align": "auto",
        "cellOptions": { "type": "auto" },
        "inspect": false
      }
    },
    "overrides": [
      {
        "matcher": { "id": "byName", "options": "Requests/s" },
        "properties": [
          { "id": "unit", "value": "reqps" },
          { "id": "decimals", "value": 2 },
          { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } }
        ]
      }
    ]
  }
}
