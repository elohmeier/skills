#!/bin/sh
set -eu

SOURCE=$0
while [ -L "$SOURCE" ]; do
    SOURCE_DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
    SOURCE=$(readlink "$SOURCE")
    case $SOURCE in
        /*) ;;
        *) SOURCE=$SOURCE_DIR/$SOURCE ;;
    esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
GRAFANA_DASHBOARD_V2_CALLER_DIR=$(pwd)
export GRAFANA_DASHBOARD_V2_CALLER_DIR
cd "$SCRIPT_DIR/dashboard-v2-tool"
exec go run . "$@"
